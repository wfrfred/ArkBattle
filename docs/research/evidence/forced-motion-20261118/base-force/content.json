      "pinnedTables": "Fetch the three exact decoded CN game-data URLs and verify the fingerprints. Apply the JSON Pointers to verify the projection.",
      "assetSetup": "from pathlib import Path; import runpy; out = Path('/tmp/ark-base-force'); out.mkdir(exist_ok=True); extract = runpy.run_path('docs/research/evidence/forced-motion-20261118/push/extract_push_config.py')['extract_with']",
